# Copy this file to `.env` and fill in local values.
# Never commit a real `.env` file or real credentials.

# PostgreSQL connection string used by Prisma and the API.
DATABASE_URL="postgresql://arrt:arrt@localhost:5432/arrt?schema=public"

# HTTP port for the Express API.
PORT=4000

# Allowed browser origins for CORS. Comma-separated. Requests without an Origin
# header (curl, server-to-server) are always allowed.
FRONTEND_URL="http://localhost:3000"

# development | test | production
NODE_ENV=development

# ---- Live collection gates ----
# All live values are disabled/absent by default. Do not fill these in until
# written authorization and permitted collection limits are confirmed.
# The operator solves the reCAPTCHA manually in a visible Chrome window;
# no solver, token reading, stealth or proxy rotation is implemented.

LIVE_AUTHORIZATION_CONFIRMED="false"
LIVE_AUTHORIZATION_REFERENCE=""
# Comma-separated scope labels, e.g. "ARRT_VERIFY_CREDENTIALS,SUPERVISED_RUN"
LIVE_AUTHORIZATION_SCOPE=""

LIVE_CAPTCHA_APPROVED="false"
LIVE_CAPTCHA_APPROVAL_REFERENCE=""

# Permitted collection limits. All three are required for live execution.
# Bounds: records/job <= 100000, searches/job <= 10000, jobs/day <= 1000.
LIVE_MAX_RECORDS_PER_JOB=""
LIVE_MAX_SEARCHES_PER_JOB=""
LIVE_MAX_JOBS_PER_DAY=""

# Visible Chrome. Keep LIVE_BROWSER_HEADLESS="false" for supervised runs.
LIVE_BROWSER_EXECUTABLE_PATH=""
# Local browser profile dir for session preservation (never stored in the DB).
LIVE_BROWSER_USER_DATA_DIR=".browser-profile"
LIVE_BROWSER_HEADLESS="false"

# ---- Daily scheduler (optional) ----
# One supervised collection job per day. A person must still solve the CAPTCHA
# in the visible Chrome window when it fires, or the run times out and fails.
COLLECTION_CRON_ENABLED="false"
# Hour of day, 0-23 local time (default 2).
COLLECTION_CRON_HOUR="2"
