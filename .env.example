# ---------------------------------------------------------------------------
# ENVIRONMENT VARIABLE REFERENCE — ARRT supervised collection demo
# ---------------------------------------------------------------------------
# REFERENCE ONLY. Never commit real values or credentials.
#
# Copy the per-app templates into real, git-ignored env files before running:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env.local
#
# Live collection is FAIL-CLOSED: every LIVE_* value below must be set and
# valid or the Run button is rejected before any browser or ARRT request.
# The reCAPTCHA is solved by the operator in the visible Chrome window —
# there is no solver, token access, stealth or proxy rotation.

# === Backend: core =========================================================
# REQUIRED. PostgreSQL connection string used by Prisma and the API.
# Migrations must be applied: cd backend && npx prisma migrate deploy
DATABASE_URL="postgresql://arrt:arrt@localhost:5432/arrt?schema=public"

# OPTIONAL. Defaults shown here.
PORT=4000
NODE_ENV="development"
# Comma-separated allowed browser origins for CORS.
FRONTEND_URL="http://localhost:3000"

# === Backend: live collection gates (ALL REQUIRED for a live run) ==========
# Written authorization must be confirmed before any live request.
LIVE_AUTHORIZATION_CONFIRMED="true"
# Any non-empty reference to the written approval.
LIVE_AUTHORIZATION_REFERENCE="AUTH-2026-001"
# Comma-separated scope labels; at least one is required.
LIVE_AUTHORIZATION_SCOPE="ARRT_VERIFY_CREDENTIALS,SUPERVISED_RUN"

# Manual CAPTCHA procedure must be explicitly approved.
LIVE_CAPTCHA_APPROVED="true"
# Any non-empty reference to that approval.
LIVE_CAPTCHA_APPROVAL_REFERENCE="CAPTCHA-APPROVAL-2026-001"

# Permitted collection limits. All three must be positive integers.
# Hard bounds (cannot be raised by env):
#   records/job <= 100000, searches/job <= 10000, jobs/day <= 1000
LIVE_MAX_RECORDS_PER_JOB="350"
LIVE_MAX_SEARCHES_PER_JOB="100"
LIVE_MAX_JOBS_PER_DAY="10"

# Visible Chrome. Headless is always rejected for supervised runs.
# puppeteer-core has NO bundled browser, so the executable path is required
# at runtime even though the gate only enforces headless=false.
# Use forward slashes on Windows.
LIVE_BROWSER_EXECUTABLE_PATH="C:/Program Files/Google/Chrome/Application/chrome.exe"
# OPTIONAL. Local profile dir that preserves the supervised session.
# Never commit this directory; it is git-ignored.
LIVE_BROWSER_USER_DATA_DIR=".browser-profile"
LIVE_BROWSER_HEADLESS="false"

# === Backend: daily scheduler (optional) ===================================
# Runs one supervised collection job per day. It still requires a person at the
# machine to solve the CAPTCHA in the visible Chrome window; if nobody solves
# it, the run times out and the job fails. Disabled by default.
COLLECTION_CRON_ENABLED="false"
# Hour of day to trigger, 0-23 local time (default 2).
COLLECTION_CRON_HOUR="2"

# === Frontend ==============================================================
# Base URL of the Express API. Must be listed in the backend FRONTEND_URL
# for CORS. Copy into frontend/.env.local.
NEXT_PUBLIC_API_URL="http://localhost:4000"
